# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, local Postgres, or `npx prisma dev`)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumora?schema=public"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Public base URL (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"

# Seeded admin account (used by `npm run db:seed`)
ADMIN_EMAIL="hello.lumoradesign@gmail.com"
ADMIN_PASSWORD=""
# Set to "false" to skip the demo client in production
SEED_DEMO="true"

# Email. Use EITHER Gmail SMTP (easiest) OR Resend. If neither is set, emails are
# NOT sent: they are only printed to the dev server log.
#
# Gmail: turn on 2-Step Verification for hello.lumoradesign@gmail.com, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it into SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="hello.lumoradesign@gmail.com"
SMTP_PASS=""
#
# Resend (alternative; needs a verified domain such as lumoradesign.uk):
RESEND_API_KEY=""
# Optional sender override. Leave empty to send as the SMTP account (required for Gmail).
EMAIL_FROM=""
# Where "new quote" notifications go
ADMIN_NOTIFY_EMAIL="hello.lumoradesign@gmail.com"

# Stripe (test keys while developing). Without these, "Pay now" is disabled.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
