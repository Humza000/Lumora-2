# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, local Postgres, or `npx prisma dev`)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lumora?schema=public"

# 32+ random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Public base URL (used in emails and Stripe redirects)
APP_URL="http://localhost:3000"

# Seeded admin account (used by `npm run db:seed`)
ADMIN_EMAIL="admin@lumoradesign.uk"
ADMIN_PASSWORD=""
# Set to "false" to skip the demo client in production
SEED_DEMO="true"

# Email (Resend). If RESEND_API_KEY is empty, emails are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="Lumora <hello@lumoradesign.uk>"
# Where "new quote" notifications go
ADMIN_NOTIFY_EMAIL=""

# Stripe (test keys while developing). Without these, "Pay now" is disabled.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
